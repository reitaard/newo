menu "Newo2 CSI and ESP-NOW node"

config NEWO_WIFI_SSID
    string "Wi-Fi SSID"
    default ""
    help
        Configure locally. The generated sdkconfig is ignored and must not be committed.

config NEWO_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""

config NEWO_NODE_ID
    int "Newo2 node ID"
    range 1 4294967295
    default 2

config NEWO_PATH_ID
    int "Router CSI path ID"
    range 0 3
    default 2
    help
        Newo2 uses 2=ROUTER_NEWO2 for AP-originated frames.

config NEWO_COLLECTOR_IPV4
    string "Collector IPv4 address"
    default "192.168.1.100"

config NEWO_COLLECTOR_PORT
    int "Collector UDP port"
    range 1 65535
    default 5005

config NEWO_CSI_RATE_HZ
    int "Retained Router-to-Newo2 CSI frames per second"
    range 1 50
    default 20

choice NEWO_SOURCE_FILTER_MODE
    prompt "CSI source-MAC filter"
    default NEWO_SOURCE_FILTER_AP

config NEWO_SOURCE_FILTER_NONE
    bool "Disabled (diagnostic only)"

config NEWO_SOURCE_FILTER_AP
    bool "Connected access-point BSSID"

config NEWO_SOURCE_FILTER_CUSTOM
    bool "Custom source MAC"

endchoice

config NEWO_SOURCE_MAC
    string "Custom source MAC (aa:bb:cc:dd:ee:ff)"
    default ""
    depends on NEWO_SOURCE_FILTER_CUSTOM

config NEWO_GATEWAY_PING_ENABLE
    bool "Generate controlled traffic by pinging the STA gateway"
    default y

config NEWO_GATEWAY_PING_HZ
    int "Gateway pings per second"
    range 1 50
    default 20
    depends on NEWO_GATEWAY_PING_ENABLE

config NEWO_QUEUE_DEPTH
    int "Static CSI queue depth"
    range 4 64
    default 16

choice NEWO_ESPNOW_MODE
    prompt "ESP-NOW probe role"
    default NEWO_ESPNOW_TRANSMIT

config NEWO_ESPNOW_NONE
    bool "Disabled"

config NEWO_ESPNOW_RECEIVE
    bool "Receive probes"

config NEWO_ESPNOW_TRANSMIT
    bool "Transmit probes to Newo"

endchoice

config NEWO_ESPNOW_PEER_MAC
    string "Newo station MAC (aa:bb:cc:dd:ee:ff)"
    default ""
    depends on !NEWO_ESPNOW_NONE

config NEWO_ESPNOW_PROBE_HZ
    int "ESP-NOW probe packets per second"
    range 1 50
    default 20
    depends on NEWO_ESPNOW_TRANSMIT

endmenu
