# GOOUUU ESP32-S3-CAM native-JPEG vision benchmark
# Target: ESP32-S3-WROOM-1 N16R8 (16 MB flash, 8 MB Octal PSRAM)

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# OV3660 + JPEG + PSRAM DMA has a known driver issue in esp32-camera 2.1.7.
# Keep the native-JPEG capture path on the stable non-PSRAM-DMA mode.
CONFIG_CAMERA_PSRAM_DMA=n

# Pack both detectors so FAST/RANGE can use MSR+MNP and ACCURATE can use ESPDet-224.
CONFIG_HUMAN_FACE_DETECT_MODEL_IN_FLASH_RODATA=y
CONFIG_FLASH_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_FLASH_ESPDET_PICO_224_224_FACE=y
CONFIG_FLASH_ESPDET_PICO_416_416_FACE=n
CONFIG_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
