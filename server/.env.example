HOST=127.0.0.1
PORT=8788
PUBLIC_BASE_URL=https://newo.reitaard.de
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
NEWO_DEVICE_ID=newo-01
NEWO_DEVICE_SECRET=
# Voice WebSocket (/voice): raw mono signed 16-bit PCM little-endian by default.
# It uses the same X-Newo-Device-Id and Authorization bearer credentials as /device.
VOICE_SAMPLE_RATE=16000
VOICE_CHANNELS=1
VOICE_BITS_PER_SAMPLE=16
VOICE_MAX_CHUNK_BYTES=65536
VOICE_MAX_STREAM_BYTES=19200000
# Close an authenticated voice socket that sends no binary microphone PCM.
VOICE_FIRST_AUDIO_TIMEOUT_MS=2500
# Bundle direct 20 ms ESP frames into bounded worker calls; valid range is 80-120 ms.
VOICE_ASR_BATCH_MS=100
# Development-only WAV capture. Keep disabled in production; captures are not committed.
VOICE_SAVE_WAV=false
VOICE_CAPTURE_DIRECTORY=/tmp/newo-voice
# sherpa streaming ASR. libri-giga is the primary higher-accuracy model; 20m remains a quick fallback/reference.
# Leave VOICE_ASR_MODEL_DIRECTORY empty to select the bundled path from VOICE_SHERPA_MODEL.
VOICE_ASR_BACKEND=sherpa
VOICE_SHERPA_MODEL=libri-giga
VOICE_ASR_MODEL_DIRECTORY=
VOICE_ASR_THREADS=2
# Global contextual bias for the libri-giga BPE model. One phrase per line; score is deliberately conservative.
VOICE_ASR_HOTWORDS_ENABLED=true
VOICE_ASR_HOTWORDS_FILE=config/newo-hotwords.txt
VOICE_ASR_HOTWORDS_SCORE=1.5
# Emits per-connection audio/partial/final timing diagnostics but never stores raw audio.
VOICE_LIVE_TEST_MODE=false

# One-turn local voice assistant. The example is private localhost only; do not
# expose the model service publicly. Leave disabled until its local runtime is ready.
ASSISTANT_ENABLED=false
ASSISTANT_BASE_URL=http://127.0.0.1:8181
ASSISTANT_MODEL=helix-qwen3-0.6b
ASSISTANT_API_KEY=
ASSISTANT_TIMEOUT_MS=15000
ASSISTANT_MAX_OUTPUT_TOKENS=48
ASSISTANT_MAX_REPLY_CHARS=240

# Telegram reply TTS. /speaker uses the same authenticated device credentials.
# Output is always raw mono 24 kHz signed PCM16 little-endian.
TTS_ENABLED=false
# Keep the established 24 kbps / 40 ms native Opus transport. PCM is only a legacy device fallback.
SPEAKER_CODEC=opus
# pocket is the default local warm INT8 Michael service. Set TTS_BACKEND=kokoro for rollback.
TTS_BACKEND=pocket
# Pocket ignores this and is pinned to michael; retain Kokoro's rollback voice.
TTS_VOICE=am_michael
TTS_SPEED=1.0
TTS_SAMPLE_RATE=24000
TTS_RATE=155
# Pocket is raw/native (no Kokoro high-pass, gain, or limiter). This applies to Kokoro/espeak only.
TTS_GAIN_DB=2
TTS_MAX_TEXT_CHARS=300
TTS_MAX_PCM_BYTES=2880000
KOKORO_BASE_URL=http://127.0.0.1:8010
KOKORO_REQUEST_TIMEOUT_MS=30000
KOKORO_STREAM_NO_PROGRESS_MS=10000
KOKORO_STREAM_ABSOLUTE_MS=70000
# Local-only Pocket service. Start server/pocket-tts-service.py from the isolated Pocket venv first.
POCKET_BASE_URL=http://127.0.0.1:8123
POCKET_REQUEST_TIMEOUT_MS=30000
POCKET_STREAM_NO_PROGRESS_MS=10000
POCKET_STREAM_ABSOLUTE_MS=70000
# Persists the automatic Telegram reply speaker toggle; relative to the server working directory.
RUNTIME_STATE_FILE=data/runtime-state.json
