# Standalone Newo2 bridge. Put these values in server/.env beside the existing Newo config.
NEWO2_BRIDGE_HOST=127.0.0.1
NEWO2_BRIDGE_PORT=8792
NEWO2_DEVICE_ID=newo2-01
NEWO2_DEVICE_SECRET=
# Separate credential for localhost admin callers such as the future Telegram adapter.
NEWO2_ADMIN_SECRET=
NEWO2_SNAPSHOT_DIRECTORY=data/newo2/snapshots
NEWO2_SNAPSHOT_RETENTION=200
NEWO2_VIDEO_DIRECTORY=data/newo2/videos
NEWO2_FFMPEG=ffmpeg
NEWO2_VISION_BASE_URL=http://127.0.0.1:8183/v1
NEWO2_VISION_MODEL=newoai-vision
NEWO2_PUBLIC_VISION_URL=https://smonitor.reitaard.de/vision
# Optional: send every accepted Newo2 snapshot to one Telegram chat.
# Uses the existing TELEGRAM_BOT_TOKEN from server/.env.
NEWO2_TELEGRAM_CHAT_ID=
