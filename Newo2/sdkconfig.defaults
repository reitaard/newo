# Newo2 production camera firmware
# GOOUUU ESP32-S3-CAM V1.5 / ESP32-S3-WROOM-1 N16R8
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# Newo2 stores human-readable SD paths such as snapshots/snapshot-000.jpg
# and videos/video-00000001.mjpeg. ESP-IDF 5.5 defaults to FAT 8.3 names only,
# so production must explicitly enable long filenames.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
# The camera stream and control channel share one WebSocket. Keep TX locking
# separate from RX so sustained 20 FPS sends cannot starve the receive task.
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
CONFIG_ESP_WS_CLIENT_TX_LOCK_TIMEOUT_MS=2000
# Keep the camera choices that survived the physical v6 soak.
CONFIG_CAMERA_PSRAM_DMA=n
CONFIG_CAMERA_JPEG_MODE_FRAME_SIZE_AUTO=n
CONFIG_CAMERA_JPEG_MODE_FRAME_SIZE_CUSTOM=y
CONFIG_CAMERA_JPEG_MODE_FRAME_SIZE=262144
# Validate public TLS certificates used by the Newo VPS.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
